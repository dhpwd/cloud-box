# Copy to box.env at the repo root and fill in. Every script on the box reads
# it, as root and as the box user. An environment variable of the same name
# wins over this file. It holds no secret.

# The non-root account the agents run as.
BOX_USER=agent

# The SSH public key of whoever builds the box. 01-base.sh lets it sign in as
# BOX_USER, and 06-handover.sh removes it from root and BOX_USER.
OPERATOR_PUBKEY="ssh-ed25519 <the builder's public key> <comment>"

# The repos to clone into ~/Workspace, each <local dir>=<github owner/repo>,
# separated by spaces. Leave it out when VAULTS is set and there are no repos.
REPOS="app=example-org/app api=example-org/api-server notes=example-org/notes"

# Obsidian vaults that optional/obsidian-sync.sh keeps in two-way sync with the
# owner's Obsidian Sync, each <local dir>=<remote vault name or ID>, separated by
# ';'. A local dir also in REPOS is one folder, cloned and synced.
# VAULTS="journal=Personal Notes; research=Research"

# Which repos or vaults get a Remote Control server, each <dir> or <dir>:<agent>,
# where <dir> is a local dir from REPOS or VAULTS and <agent> is a custom agent
# every session that server starts runs as. Leave it out for every dir in REPOS
# and VAULTS, no agent.
RC_REPOS="app api notes:writer"

# same-dir: every session from the app works in the repo's own checkout.
# worktree: each session gets its own git worktree (repos only, not a vault
# without git).
RC_SPAWN=same-dir

# The most sessions one repo's server runs at once. Leave it out for Claude
# Code's own default.
# RC_CAPACITY=
